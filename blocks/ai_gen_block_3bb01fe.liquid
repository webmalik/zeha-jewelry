{% doc %}
  @prompt
    A heading with an animated glowing effect
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-glowing-heading-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    text-align: {{ block.settings.alignment }};
    padding: {{ block.settings.vertical_padding }}px 0;
  }

  .ai-glowing-heading-{{ ai_gen_id }}__text {
    display: inline-block;
    margin: 0;
    color: {{ block.settings.text_color }};
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-size: {{ block.settings.font_size }}px;
    font-weight: {{ block.settings.font_weight }};
    line-height: 1.1;
    letter-spacing: {{ block.settings.letter_spacing }}px;
    text-wrap: balance;
    text-shadow: 0 0 {{ block.settings.glow_size }}px {{ block.settings.glow_color }}, 0 0 {{ block.settings.glow_size | times: 2 }}px {{ block.settings.glow_color }};
    animation: ai-glowing-heading-pulse-{{ ai_gen_id }} {{ block.settings.animation_speed }}s ease-in-out infinite alternate;
  }

  @keyframes ai-glowing-heading-pulse-{{ ai_gen_id }} {
    from {
      text-shadow: 0 0 {{ block.settings.glow_size | times: 0.5 }}px {{ block.settings.glow_color }}, 0 0 {{ block.settings.glow_size }}px {{ block.settings.glow_color }};
    }
    to {
      text-shadow: 0 0 {{ block.settings.glow_size }}px {{ block.settings.glow_color }}, 0 0 {{ block.settings.glow_size | times: 2 }}px {{ block.settings.glow_color }};
    }
  }

  @media screen and (prefers-reduced-motion: reduce) {
    .ai-glowing-heading-{{ ai_gen_id }}__text {
      animation: none;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-glowing-heading-{{ ai_gen_id }}__text {
      font-size: {{ block.settings.mobile_font_size }}px;
    }
  }
{% endstyle %}

<div class="ai-glowing-heading-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <h2 class="ai-glowing-heading-{{ ai_gen_id }}__text">{{ block.settings.heading | escape }}</h2>
</div>

{% schema %}
{
  "name": "Glowing heading",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shine brighter"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Font",
      "default": "helvetica_n4"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#101010"
    },
    {
      "type": "color",
      "id": "glow_color",
      "label": "Glow",
      "default": "#D4AF37"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Desktop size",
      "min": 20,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 52
    },
    {
      "type": "range",
      "id": "mobile_font_size",
      "label": "Mobile size",
      "min": 18,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 34
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Weight",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "500"
    },
    {
      "type": "range",
      "id": "glow_size",
      "label": "Glow size",
      "min": 2,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "animation_speed",
      "label": "Pulse speed",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 4
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "label": "Letter spacing",
      "min": 0,
      "max": 5,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "vertical_padding",
      "label": "Vertical spacing",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Glowing heading"
    }
  ],
  "tag": null,
  "class": "glowing-heading-block"
}
{% endschema %}