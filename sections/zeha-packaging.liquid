{% render 'zeha-assets' %}
<div class="zeha-scope">
  <section
    aria-labelledby="packaging-title-{{ section.id }}"
    class="packaging"
    id="packaging-{{ section.id }}"
    data-zeha-packaging
    data-autoplay-mode="{{ section.settings.autoplay_mode }}"
  >
    <div class="container">
      <div class="section-heading reveal">
        <div>
          <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
          <h2 id="packaging-title-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        </div>
        <div>
          <p>{{ section.settings.text | escape }}</p>
        </div>
      </div>

      <div class="packaging-grid">
        {% for block in section.blocks %}
          {% if forloop.index == 1 %}
            {% assign fallback_asset = 'story-zeha.png' %}
          {% else %}
            {% assign fallback_asset = 'product-baraka.png' %}
          {% endif %}

          <button
            aria-label="{{ block.settings.aria_label | escape }}"
            class="packaging-card reveal{% if block.settings.video != blank %} has-video{% endif %}"
            type="button"
            data-zeha-video-card
            {{ block.shopify_attributes }}
          >
            {% if block.settings.video != blank %}
              {{
                block.settings.video
                | video_tag:
                  autoplay: false,
                  muted: true,
                  loop: section.settings.loop_video,
                  controls: false,
                  preload: 'metadata',
                  playsinline: true,
                  image_size: '1400x',
                  class: 'packaging-video',
                  data-zeha-video: ''
              }}

              {% if block.settings.image != blank %}
                {{
                  block.settings.image
                  | image_url: width: 1400
                  | image_tag:
                    loading: 'lazy',
                    alt: block.settings.alt,
                    widths: '480,720,960,1200,1400',
                    sizes: '(max-width: 700px) 100vw, 55vw',
                    class: 'packaging-poster'
                }}
              {% endif %}
            {% elsif block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 1400
                | image_tag:
                  loading: 'lazy',
                  alt: block.settings.alt,
                  widths: '480,720,960,1200,1400',
                  sizes: '(max-width: 700px) 100vw, 55vw'
              }}
            {% else %}
              <img
                alt="{{ block.settings.alt | escape }}"
                loading="lazy"
                src="{{ fallback_asset | asset_url }}"
                width="1400"
                height="1000"
              >
            {% endif %}

            <span aria-hidden="true" class="packaging-play">▶</span>
          </button>
        {% endfor %}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Zeha — Packaging",
  "max_blocks": 2,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Das Zeha-Erlebnis"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ein besonderer Moment, bevor du die Schachtel öffnest."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Durchdachte Verpackung macht jede Bestellung zu einem persönlichen Ritual – vom ersten Öffnen bis zu dem Schmuckstück, das dich täglich begleitet."
    },
    {
      "type": "select",
      "id": "autoplay_mode",
      "label": "Video autoplay",
      "default": "viewport",
      "options": [
        {
          "value": "viewport",
          "label": "When visible on screen (on scroll)"
        },
        {
          "value": "immediate",
          "label": "Immediately after page load"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "loop_video",
      "label": "Loop videos",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "media",
      "name": "Packaging media",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Video"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Preview image",
          "info": "Optional. Used as the cover before the video starts."
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Image alt",
          "default": "Zeha-Verpackung und Schmuckdetail"
        },
        {
          "type": "text",
          "id": "aria_label",
          "label": "Button accessibility label",
          "default": "Verpackungsvideo abspielen oder pausieren"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Zeha — Packaging",
      "blocks": [
        { "type": "media" },
        { "type": "media" }
      ]
    }
  ]
}
{% endschema %}
