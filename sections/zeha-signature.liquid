{% render 'zeha-assets' %}
<div class="zeha-scope">
<section aria-labelledby="collection-title-{{ section.id }}" class="signature-collection" id="collection">
<div class="container signature-layout">
<div class="signature-copy reveal"><span class="eyebrow">{{ section.settings.eyebrow | escape }}</span><h2 id="collection-title-{{ section.id }}">{{ section.settings.heading | escape }}</h2><p>{{ section.settings.text | escape }}</p><a class="button button-primary" href="{{ section.settings.button_link | default: '#bestsellers' }}">{{ section.settings.button_label | escape }} <span aria-hidden="true">↗</span></a></div>
<div class="signature-list reveal">
{% for block in section.blocks %}<a class="signature-item" href="{{ block.settings.link | default: '#bestsellers' }}" {{ block.shopify_attributes }}><span>{{ block.settings.title | escape }}<small>{{ block.settings.subtitle | escape }}</small></span></a>{% endfor %}
</div>
</div>
</section>
</div>
{% schema %}
{
  "name":"Zeha — Signature",
  "max_blocks":4,
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Die Zeha-Signatur"},
    {"type":"text","id":"heading","label":"Heading","default":"Bedeutungsvolle Symbole, persönlich gemacht."},
    {"type":"textarea","id":"text","label":"Text","default":"Unsere orientalisch inspirierte Kollektion bringt Zehas spirituelle und kulturelle Wurzeln in eine moderne, elegante Garderobe – persönliche Schmuckstücke, die dich jeden Tag begleiten."},
    {"type":"text","id":"button_label","label":"Button","default":"Orientalischen Schmuck entdecken"},
    {"type":"url","id":"button_link","label":"Button link"}
  ],
  "blocks":[{"type":"item","name":"Signature item","settings":[{"type":"text","id":"title","label":"Title","default":"Ayatul Kursi"},{"type":"text","id":"subtitle","label":"Subtitle","default":"Glaube & Trost"},{"type":"url","id":"link","label":"Link"}]}],
  "presets":[{"name":"Zeha — Signature","blocks":[{"type":"item"},{"type":"item"},{"type":"item"},{"type":"item"}]}]
}
{% endschema %}
