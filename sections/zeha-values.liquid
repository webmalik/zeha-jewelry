{% render 'zeha-assets' %}
<div class="zeha-scope">
<section aria-label="{{ section.settings.aria_label | escape }}" class="value-strip">
  <div class="container value-grid">
    {%- for block in section.blocks -%}
      <div class="value-item reveal" {{ block.shopify_attributes }}>
        <span class="value-icon">{{ block.settings.icon }}</span>
        <span class="value-title">{{ block.settings.title | escape }}</span>
        <span class="value-copy">{{ block.settings.text | escape }}</span>
      </div>
    {%- endfor -%}
  </div>
</section>
</div>
{% schema %}
{
  "name":"Zeha — Values",
  "max_blocks":4,
  "settings":[{"type":"text","id":"aria_label","label":"Accessibility label","default":"Warum Zeha"}],
  "blocks":[{"type":"item","name":"Value","settings":[
    {"type":"text","id":"icon","label":"Icon","default":"✦"},
    {"type":"text","id":"title","label":"Title","default":"Mit Bedeutung gestaltet"},
    {"type":"textarea","id":"text","label":"Text","default":"Persönliche Symbole und durchdachte Details."}
  ]}],
  "presets":[{"name":"Zeha — Values","blocks":[{"type":"item"},{"type":"item"},{"type":"item"},{"type":"item"}]}]
}
{% endschema %}
