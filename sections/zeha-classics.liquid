{% render 'zeha-assets' %}
{% render 'js-loader', files: "component-add-to-cart.js", split: ',' %}
<div class="zeha-scope">
<section aria-labelledby="everyday-classics-title-{{ section.id }}" class="section everyday-classics" id="everyday-classics">
<div class="container">
<div class="section-heading reveal">
<div><span class="eyebrow">{{ section.settings.eyebrow | escape }}</span><h2 id="everyday-classics-title-{{ section.id }}">{{ section.settings.heading | escape }}</h2></div>
<div><p>{{ section.settings.text | escape }}</p><a class="text-link" href="{{ section.settings.link | default: '#bestsellers' }}">{{ section.settings.link_label | escape }}</a></div>
</div>
<div class="product-grid">
{% for block in section.blocks %}
  {% case forloop.index %}
    {% when 1 %}{% assign fallback_asset = section.settings.fallback_1 %}{% assign fallback_title = section.settings.fallback_title_1 %}{% assign fallback_price = section.settings.fallback_price_1 %}
    {% when 2 %}{% assign fallback_asset = section.settings.fallback_2 %}{% assign fallback_title = section.settings.fallback_title_2 %}{% assign fallback_price = section.settings.fallback_price_2 %}
    {% when 3 %}{% assign fallback_asset = section.settings.fallback_3 %}{% assign fallback_title = section.settings.fallback_title_3 %}{% assign fallback_price = section.settings.fallback_price_3 %}
    {% else %}{% assign fallback_asset = section.settings.fallback_4 %}{% assign fallback_title = section.settings.fallback_title_4 %}{% assign fallback_price = section.settings.fallback_price_4 %}
  {% endcase %}
  {% render 'zeha-product-card', block: block, section: section, fallback_asset: fallback_asset, fallback_title: fallback_title, fallback_price: fallback_price %}
{% endfor %}
</div>
</div>
</section>
</div>
{% schema %}
{
  "name": "Zeha — Classics",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Alltagsklassiker"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Die kleinen Details, die deinen Look vollenden."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Stilvolle, vielseitige Schmuckstücke für Frauen, die etwas Besonderes suchen."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Alle Klassiker entdecken"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "text",
      "id": "fallback_1",
      "label": "Fallback asset 1",
      "default": "product-clover-earrings.jpg"
    },
    {
      "type": "text",
      "id": "fallback_title_1",
      "label": "Fallback title 1",
      "default": "Perlen-Kleeblatt-Ohrringe"
    },
    {
      "type": "text",
      "id": "fallback_price_1",
      "label": "Fallback price 1",
      "default": "€44.90"
    },
    {
      "type": "text",
      "id": "fallback_2",
      "label": "Fallback asset 2",
      "default": "product-clover-bangle.jpg"
    },
    {
      "type": "text",
      "id": "fallback_title_2",
      "label": "Fallback title 2",
      "default": "Vierblättriges Goldarmband"
    },
    {
      "type": "text",
      "id": "fallback_price_2",
      "label": "Fallback price 2",
      "default": "€54.90"
    },
    {
      "type": "text",
      "id": "fallback_3",
      "label": "Fallback asset 3",
      "default": "product-alhamdulillah.png"
    },
    {
      "type": "text",
      "id": "fallback_title_3",
      "label": "Fallback title 3",
      "default": "Perlen-Tropfenohrringe"
    },
    {
      "type": "text",
      "id": "fallback_price_3",
      "label": "Fallback price 3",
      "default": "€39.90"
    },
    {
      "type": "text",
      "id": "fallback_4",
      "label": "Fallback asset 4",
      "default": "product-ayatul.png"
    },
    {
      "type": "text",
      "id": "fallback_title_4",
      "label": "Fallback title 4",
      "default": "Minimalistische Goldkette"
    },
    {
      "type": "text",
      "id": "fallback_price_4",
      "label": "Fallback price 4",
      "default": "€42.90"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "checkbox",
          "id": "use_product_image",
          "label": "Use product image",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "use_product_title",
          "label": "Use product title",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "use_product_price",
          "label": "Use product price",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "use_product_description",
          "label": "Use product description",
          "default": false
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom image"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Image alt"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price text"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom link"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Link label",
          "default": "Jetzt entdecken"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Zeha — Classics",
      "blocks": [
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        }
      ]
    }
  ]
}
{% endschema %}
